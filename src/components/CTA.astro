---
import WaveField from '~/components/WaveField.astro';
import Icon from '~/components/Icon.astro';
import { company } from '~/data/profile';
---

<section class="cta" aria-labelledby="cta-heading">
  <WaveField tone="sage" opacity={0.3} />
  <div class="wrap inner">
    <p class="eyebrow">Start a conversation</p>
    <h2 id="cta-heading">Ready to move without the translation layer?</h2>
    <p>
      Tell us where your data, AI, or platform initiative is stuck. We'll come
      back with a baseline, a plan, and the people to deliver it.
    </p>
    <div class="actions">
      <a class="button cta-button" href={`mailto:${company.email}`}>
        <Icon name="mail" size={16} /> Email {company.shortName}
      </a>
      <a class="button button--ghost" href={company.pdfPath} download>
        <Icon name="download" size={16} /> Capability statement
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    background: var(--charcoal);
    color: var(--paper);
    padding: clamp(72px, 10vw, 128px) 0;
  }
  .inner {
    position: relative;
    max-width: 820px;
    text-align: center;
  }
  .eyebrow {
    color: var(--sage);
  }
  h2 {
    color: var(--paper);
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 300;
  }
  p {
    color: rgb(247 246 242 / 0.78);
    font-size: 1.1rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }
  .cta-button {
    background: var(--sage);
    border-color: var(--sage);
    color: var(--charcoal);
  }
  .button--ghost {
    color: var(--paper);
    border-color: rgb(247 246 242 / 0.5);
  }
  .button--ghost:hover {
    background: var(--paper);
    color: var(--charcoal);
  }
</style>
