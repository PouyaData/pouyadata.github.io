---
import type { IconName } from '~/data/profile';

type UiIcon = 'arrow' | 'download' | 'mail' | 'linkedin' | 'print';

export interface Props {
  name: IconName | UiIcon;
  size?: number;
}

const { name, size = 24 } = Astro.props as Props;

// 24×24 line icons, stroked with currentColor.
const paths: Record<Props['name'], string> = {
  strategy: 'M4 20h16M6 16l4-5 3 3 5-7M15 7h3v3',
  agents:
    'M12 3v3M12 18v3M3 12h3M18 12h3M7 7l2 2M15 15l2 2M17 7l-2 2M9 15l-2 2M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z',
  platform:
    'M4 7c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3Zm0 0v5c0 1.7 3.6 3 8 3s8-1.3 8-3V7m-16 5v5c0 1.7 3.6 3 8 3s8-1.3 8-3v-5',
  cloud:
    'M7 18h10a4 4 0 0 0 .5-8A6 6 0 0 0 6 9.5 4.3 4.3 0 0 0 7 18Zm3-4 2 2 3-4',
  shield: 'M12 3 5 6v5c0 4.4 3 8.3 7 10 4-1.7 7-5.6 7-10V6l-7-3Zm-3 9 2 2 4-4',
  teach: 'M3 9l9-5 9 5-9 5-9-5Zm4 2.5V16c0 1.5 2.2 3 5 3s5-1.5 5-3v-4.5M21 9v6',
  arrow: 'M5 12h14M13 6l6 6-6 6',
  download: 'M12 4v11M7 10l5 5 5-5M5 20h14',
  mail: 'M4 6h16v12H4V6Zm0 0 8 7 8-7',
  linkedin: 'M5 9v10M5 5v.01M10 19v-6a3 3 0 0 1 6 0v6M10 10v9M4 3h16v18H4V3Z',
  print: 'M7 9V4h10v5M7 17H5v-6h14v6h-2M7 14h10v6H7v-6Z',
};
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]}></path>
</svg>
