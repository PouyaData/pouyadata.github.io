---
import Hero from '~/components/Hero.astro';
import Metrics from '~/components/Metrics.astro';
import Capabilities from '~/components/Capabilities.astro';
import WhyPouyaData from '~/components/WhyPouyaData.astro';
import FeaturedWork from '~/components/FeaturedWork.astro';
import Technologies from '~/components/Technologies.astro';
import RecentPosts from '~/components/RecentPosts.astro';
import CTA from '~/components/CTA.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const allPosts: CollectionEntry<'blog'>[] = await getCollection('blog');
const posts = allPosts
  .sort(
    (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
      b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
  )
  .slice(0, 3);
---

<Hero />
<Metrics />
<Capabilities />
<WhyPouyaData />
<FeaturedWork />
<Technologies />
<RecentPosts posts={posts} />
<CTA />
