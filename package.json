{
  "name": "astro-blog",
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run build:pdf",
    "build:pdf": "node scripts/build-pdf.mjs",
    "preview": "npm run build && astro preview",
    "check": "astro check",
    "test": "npm run check && npm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "astro": "^5.12.8",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cheerio": "^1.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "jsdom": "^26.1.0",
    "playwright": "^1.65.1",
    "prettier": "^3.3.2",
    "prettier-plugin-astro": "^0.13.0",
    "typescript-eslint": "^8.74.0",
    "vitest": "^3.2.4"
  }
}
